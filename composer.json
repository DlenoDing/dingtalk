{
    "name": "dleno/dingtalk",
    "type": "library",
    "description": "dingtalk",
    "license": "MIT",
    "keywords": ["dingtalk"],
    "require": {
        "php": ">=8.4",
        "ext-swoole": ">=6.2",
        "guzzlehttp/guzzle": "^7.0",
        "hyperf/config": "~3.2.0",
        "hyperf/context": "~3.2.0",
        "hyperf/contract": "~3.2.0",
        "hyperf/coroutine": "~3.2.0",
        "hyperf/redis": "~3.2.0",
        "hyperf/stringable": "~3.2.0",
        "hyperf/support": "~3.2.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "mockery/mockery": "^1.0",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^11.0",
        "hyperf/http-server": "~3.2.0",
        "hyperf/websocket-server": "~3.2.0",
        "swoole/ide-helper": "^6.2"
    },
    "suggest": {
        "dleno/common-core": "Use its trace id, server IP and client IP in DingTalk messages."
    },
    "autoload": {
        "psr-4": {
            "Dleno\\DingTalk\\": "src/"
        },
        "files": [
            "src/common/Functions.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "hyperf": {
            "config": "Dleno\\DingTalk\\ConfigProvider"
        }
    },
    "bin": [
    ],
    "scripts": {
        "cs-fix": "php-cs-fixer fix $1",
        "test": "phpunit --colors=always",
        "analyse": "phpstan analyse --memory-limit 1G -c phpstan.neon"
    }
}
